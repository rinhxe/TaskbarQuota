<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TaskbarQuota.Views.RemainingQuotaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TaskbarQuota.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="RemainingQuotaItemTemplate" x:DataType="vm:ProviderCardViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind DisplayName}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"/>

                    <ItemsControl ItemsSource="{x:Bind Bars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BarViewModel">
                                <Grid ColumnSpacing="12" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind Label}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <ProgressBar Value="{x:Bind Percent}"
                                                     Maximum="100"
                                                     Height="5"
                                                     Foreground="{x:Bind BarBrush}"
                                                     Visibility="{x:Bind BarVisibility}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind PercentText}"
                                               Foreground="{x:Bind PercentForeground}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer Padding="0,4,0,32"
                  HorizontalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled">
        <StackPanel Spacing="16">
            <TextBlock Text="Remaining quota"
                       Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBlock Text="Shows only the current remaining quota, without reset countdowns."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Style="{StaticResource BodyTextBlockStyle}"
                       TextWrapping="Wrap"/>

            <ListView ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}"
                      ItemTemplate="{StaticResource RemainingQuotaItemTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="False" />
        </StackPanel>
    </ScrollViewer>
</Page>
